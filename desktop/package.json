{
  "name": "edusystem-desktop",
  "version": "1.6.1",
  "description": "EduSystem Gestão Escolar Desktop",
  "author": "ViniciusNoetzold",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --config.directories.output=dist-final"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.edusystem.gestao",
    "productName": "EduSystem",
    "asar": true,
    "asarUnpack": [
      "server/**"
    ],
    "files": [
      "main.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!data/**",
          "!node_modules/.cache/**",
          "!puppeteer-cache/**",
          "!scripts/**",
          "!README.md",
          "!package-lock.json",
          "!data/database.sqlite-shm",
          "!data/database.sqlite-wal"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "EduSystem-Portable-${version}.exe"
    }
  }
}
